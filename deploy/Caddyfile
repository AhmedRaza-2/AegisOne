# AegisOne TLS reverse proxy.
# SERVER_HOST is a DNS name (certificate is issued automatically by Let's Encrypt)
# or an IP / internal hostname (Caddy's internal CA issues the certificate;
# distribute its root from the caddy-data volume to employee devices).

{
	# Set ACME_EMAIL in .env for certificate expiry notices (optional)
	email {$ACME_EMAIL:}
}

# Dashboard: https://SERVER_HOST  (plain HTTP on :80 redirects here automatically)
{$SERVER_HOST:localhost} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy dashboard:3000
}

# API (used by the dashboard and the browser extension): https://SERVER_HOST:8443
{$SERVER_HOST:localhost}:8443 {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	request_body {
		max_size 25MB
	}
	reverse_proxy backend:8000
}
