# Server-only examples. Never put any of these secrets in VITE_/NEXT_PUBLIC_ variables.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to deployed functions.
ASSISTANT_ENABLED=false
ASSISTANT_VOICE_ENABLED=false
ASSISTANT_QUOTAS_VERIFIED=false
GROQ_API_KEY=replace-with-your-free-account-server-key
ASSISTANT_CHAT_MODEL=openai/gpt-oss-120b
ASSISTANT_IP_HASH_SECRET=replace-with-at-least-32-random-characters

# Enter the ACTUAL limits for ASSISTANT_CHAT_MODEL and whisper-large-v3 from
# your Groq Free account's Limits page. Chat permits only gpt-oss-120b/20b.
# There are deliberately no guessed values. The function reserves only 80% of
# each supplied limit and remains disabled if any required value is missing.
GROQ_CHAT_RPM=
GROQ_CHAT_RPD=
GROQ_CHAT_TPM=
GROQ_CHAT_TPD=
GROQ_AUDIO_RPM=
GROQ_AUDIO_RPD=
GROQ_AUDIO_ASH=
GROQ_AUDIO_ASD=
