ate(false);\nconst [currentPage, setCurrentPage] = useState(1);\nconst [items, setItems] = useState<DataTableItem[]>([]);\nconst [hasMore, setHasMore] = useState(true);\n\nconst fetchPage = useCallback(\n  (page: number) => {\n    console.log('>>> fetch page', {page});\n    setLoading(true);\n    setTimeout(() => {\n      const start = (page - 1) * pageSize;\n      const end = start + pageSize;\n      setItems(allUsers.slice(start, end));\n      setHasMore(end < allUsers.length);\n      setLoading(false);\n    }, 500);\n  },\n  [allUsers],\n);\n\nuseEffect(() => {\n  fetchPage(currentPage);\n}, [currentPage, fetchPage]);\n\nconst handlePageChange = useCallback((page: number) => {\n  console.log('>>> handlePageChange', page);\n  setCurrentPage(page);\n}, []);\n\nconsole.log('>>> [example] pagination', {\n  pageSize,\n  currentPage,\n  hasMore,\n  onPageChange: handlePageChange,\n});\n\nreturn (\n  <DataTable\n    items={items}\n    columns={columns}\n    loading={loading}\n    pagination={{\n      pageSize,\n      currentPage,\n      hasMore,\n      onPageChange: handlePageChange,\n    }}\n  />\n)\n};\n\nexport default App;",options:{showRender:!0,showSource:!0,resizable:!1}}},empty:{9:{source:"import React from 'react';\nimport {DataTable, DataTableColumn} from '@stripe/ui-extension-sdk/ui';\n\nconst columns: DataTableColumn[] = [\n  {key: 'name', label: 'Name'},\n  {key: 'email', label: 'Email', cell: {type: 'link'}},\n  {\n    key: 'status',\n    label: 'Status',\n    cell: {\n      type: 'status',\n      statusMap: {Active: 'positive', Inactive: 'negative'},\n    },\n  },\n];\n\nreturn <DataTable items={[]} columns={columns} />",options:{showRender:!0,showSource:!0,resizable:!1}}},emptyMessage:{9:{source:"import React from 'react';\nimport {\n  DataTable,\n  DataTableColumn,\n  DataTableItem,\n} from '@stripe/ui-extension-sdk/ui';\n\nconst columns: DataTableColumn[] = [\n  {key: 'name', label: 'Name'},\n  {key: 'email', label: 'Email', cell: {type: 'link'}},\n  {