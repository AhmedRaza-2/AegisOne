ripeApiFetch'\n                ? 'stripeHttpClient'\n                : 'stripeApiFetch',\n            )\n          }\n        />\n        <Button\n          onPress={() =>\n            customerApi\n              .create(`Customer${Date.now()}`)\n              .then(() => refreshCustomers())\n          }\n        >\n          Create Customer\n        </Button>\n      </Box>\n      <Box css={{stack: 'y', gap: 'small'}}>\n        {customers.map((customer) => (\n          <Box key={customer.id} css={{stack: 'x', gap: 'small'}}>\n            {customer.name}\n            <Box css={{stack: 'x', gap: 'small'}}>\n              <Button\n                onPress={() =>\n                  customerApi\n                    .update(customer.id, `Customer${Date.now()}`)\n                    .then(() => refreshCustomers())\n                }\n              >\n                Update name\n              </Button>\n              <Button\n                onPress={() =>\n                  customerApi\n                    .delete(customer.id)\n                    .then(() => refreshCustomers())\n                }\n              >\n                Delete\n              </Button>\n            </Box>\n          </Box>\n        ))}\n      </Box>\n    </Box>\n  </FullPageView>\n)",options:{showRender:!0,showSource:!0,resizable:!1}}},fetchEvents:{9:{source:"import Stripe from 'stripe';\nimport React from 'react';\nimport {\n  createHttpClient,\n  STRIPE_API_KEY,\n} from '@stripe/ui-extension-sdk/http_client';\nimport {Box, Button, FullPageView} from '@stripe/ui-extension-sdk/ui';\nimport {RemoteData, useRemoteData} from '/data/useRemoteData';\n\nconst httpClient = createHttpClient();\nconst stripe = new Stripe(STRIPE_API_KEY, {httpClient});\n\nconst {result, error, isLoading, fetch} = useRemoteData(fetchEvents);\n\nreturn (\n  <FullPageView>\n    <Box css={{stack: 'y', gap: 'large', padding: 'large'}}>\n      <Button onPress={fetch} disabled={isLoading}>\n        Fetch events\n      </Button>\n 