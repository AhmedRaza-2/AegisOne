\n      <MenuItem>Cancel</MenuItem>\n    </MenuGroup>\n    <MenuGroup title=\"Connections\">\n      <MenuItem>View customer</MenuItem>\n      <MenuItem>View subscription</MenuItem>\n    </MenuGroup>\n  </Menu>\n</Box>",options:{showRender:!0,showSource:!0,resizable:!1}},9:{source:"<Box\n  css={{\n    backgroundColor: 'surface',\n    padding: 'medium',\n    borderRadius: 'medium',\n  }}\n>\n  <Menu aria-label=\"Menu\">\n    <MenuGroup title=\"Actions\">\n      <MenuItem>Duplicate</MenuItem>\n      <MenuItem>Edit</MenuItem>\n      <MenuItem>Cancel</MenuItem>\n    </MenuGroup>\n    <MenuGroup title=\"Connections\">\n      <MenuItem>View customer</MenuItem>\n      <MenuItem>View subscription</MenuItem>\n    </MenuGroup>\n  </Menu>\n</Box>",options:{showRender:!0,showSource:!0,resizable:!1}}},items:{8:{source:"<Box\n  css={{\n    backgroundColor: 'surface',\n    padding: 'medium',\n    borderRadius: 'medium',\n  }}\n>\n  <Menu aria-label=\"Menu\">\n    <MenuItem>Edit</MenuItem>\n    <MenuItem disabled>Copy</MenuItem>\n    <MenuItem>Paste</MenuItem>\n  </Menu>\n</Box>",options:{showRender:!0,showSource:!0,resizable:!1}},9:{source:"<Box\n  css={{\n    backgroundColor: 'surface',\n    padding: 'medium',\n    borderRadius: 'medium',\n  }}\n>\n  <Menu aria-label=\"Menu\">\n    <MenuItem>Edit</MenuItem>\n    <MenuItem disabled>Copy</MenuItem>\n    <MenuItem>Paste</MenuItem>\n  </Menu>\n</Box>",options:{showRender:!0,showSource:!0,resizable:!1}}},trigger:{8:{source:'<Menu trigger={<Button>Menu</Button>}>\n  <MenuGroup title="Actions">\n    <MenuItem>Duplicate</MenuItem>\n    <MenuItem disabled>Edit</MenuItem>\n    <MenuItem>Cancel</MenuItem>\n  </MenuGroup>\n  <MenuGroup title="Connections">\n    <MenuItem>View customer</MenuItem>\n    <MenuItem>View subscription</MenuItem>\n  </MenuGroup>\n</Menu>',options:{showRender:!0,showSource:!0,resizable:!1}},9:{source:'<Menu trigger={<Button>Menu</Button>}>\n  <MenuGroup title="Actions">\n    <MenuItem>Duplicate</MenuItem>\n    <MenuItem disabled>Edit</MenuItem>\n    <MenuItem>Cancel</MenuItem>\n  </MenuGroup>\n  <MenuGroup title="Connections">\n    <MenuItem>View customer</MenuItem>\n    <MenuItem>View subscription</MenuItem>\n  </MenuGroup>\n</Menu>',options:{showRender:!0,showSource:!0,resizable:!1}}}},MeterChartNext:{basic:{9:{source:"import React from 'react';\nimport {Box} from '@stripe/ui-extension-sdk/ui';\nimport {MeterChart, MeterChartData} from '@stripe/ui-extension-sdk/ui/next'\n\nconst data: MeterChartData = [\n  {label: 'Amsterdam', value: 20, country: 'Netherlands'},\n  {label: 'Barcelona', value: 30, country: 'Spain'},\n  {label: 'Dublin', value: 60, country: 'Ireland'},\n  {label: 'Tokyo', value: 80, country: 'Japan'},\n];\n\nreturn (\n  <Box css={{width: 'fill'}}>\n    <MeterChart data={data} legendEnabled />\n  </Box>\n)",options:{showRender:!0,showSource:!0,resizable:!1}}},segmentPress:{9:{source:"import React from 'react';\nimport {Box} from '@stripe/ui-extension-sdk/ui';\nimport {MeterChart, MeterChartData} from '@stripe/ui-extension-sdk/ui/next'\n\nconst data: MeterChartData = [\n  {label: 'Amsterdam', value: 20, country: 'Netherlands'},\n  {label: 'Barcelona', value: 30, country: 'Spain'},\n  {label: 'Dublin', value: 60, country: 'Ireland'},\n  {label: 'Tokyo', value: 80, country: 'Japan'},\n];\n\nreturn (\n  <Box css={{width: 'fill'}}>\n    <MeterChart\n      data={data}\n      legendEnabled\n      onSegmentClick={(payload) => {\n        console.log('>>> segment clicked', payload);\n      }}\n    />\n  </Box>\n)",options:{showRender:!0,showSource:!0,resizable:!1}}},unitFormat:{9:{source:"import React from 'react';\nimport {Box} from '@stripe/ui-extension-sdk/ui';\nimport {MeterChart, MeterChartData} from '@stripe/ui-extension-sdk/ui/next'\n\nconst data: MeterChartData = [\n  {label: 'LATAM', value: 400_00},\n  {label: 'EMEA', value: 300_00},\n  {label: 'APAC', value: 200_00},\n  {label: 'US', value: 100_00},\n];\n\nreturn (\n  <Box css={{width: 'fill'}}>\n    <MeterChart\n      data={data}\n      legendEnabled\n      unitFormat={{unit: 'currency', options: {currency: 'USD'}}}\n    />\n  </Box>\n)",options:{showRender:!0,showSource:!0,resizable:!1}}}},OnboardingView:{basic:{9:{source:"import React, {useState, useReducer, useCallback} from 'react';\nimport {\n  FormFieldGroup,\n  TextField,\n  OnboardingView,\n  Switch,\n  TaskListItemProps,\n} from '@stripe/ui-extension-sdk/ui';\n\nconst onboardingTasks: Record<TaskName, TaskListItemProps> = {\n  addInfo: {\n    title: 'Add business info',\n    status: 'in-progress',\n    onPress: () => handlePress('addInfo'),\n  },\n  connectBank: {\n    title: 'Connect your bank',\n    status: 'not-started',\n    onPress: () => handlePress('connectBank'),\n  },\n  review: {\n    title: 'Review and finish',\n    status: 'not-started',\n    onPress: () => handlePress('review'),\n  },\n};\n\n// These view implement the UI required by a particular onboarding step\nconst steps: Record<TaskName, React.FunctionComponent> = {\n  addInfo: () => (\n    <FormFieldGroup legend=\"Business Info\" description=\"Add business info\">\n      <TextField\n        label=\"Company name\"\n        placeholder=\"Company name\"\n        hiddenElements={['label']}\n      />\n    </FormFieldGroup>\n  ),\n  connectBank: () => (\n    <FormFieldGroup\n      legend=\"Connect your bank\"\n      description=\"Enter the bank account to which withdrawals will be sent.\"\n    >\n      <TextField\n        label=\"Bank name\"\n        placeholder=\"Bank name\"\n        hiddenElements={['label']}\n      />\n    </FormFieldGroup>\n  ),\n  review: () => (\n    <FormFieldGroup legend=\"Specify settings\" layout=\"vertical\">\n      <Switch\n        label=\"Enable automatic transfers\"\n        description=\"Enable automatic transfers\"\n      />\n      <Switch\n        label=\"Enable auto-import of transactions\"\n        description=\"Enable auto-import of transactions\"\n      />\n    </FormFieldGroup>\n  ),\n};\n\nconst handlePress = useCallback((taskName: TaskName) => {\n  setTaskName(taskName);\n  dispatch({type: 'TOGGLE_STATUS', taskName});\n}, []);\n\nconst [taskName, setTaskName] = useState<TaskName>('addInfo');\nconst [tasks, dispatch] = useReducer(taskReducer, onboardingTasks);\nconst taskListItems = Object.values(tasks);\n\nconst title = tasks[taskName].title;\nconst description = `Please complete the onboarding step.`;\nconst completed = taskListItems.every((item) => item.status === 'complete');\nconst OnboardingViewContent = steps[taskName];\n\nreturn (\n  <OnboardingView\n    title={title}\n    description={description}\n    completed={completed}\n    tasks={taskListItems}\n  >\n    <OnboardingViewContent />\n  </OnboardingView>\n);\n\nfunction getNextStatus(\n  status: string,\n): 'not-started' | 'in-progress' | 'complete' {\n  switch (status) {\n    case 'complete':\n      return 'not-started';\n    case 'not-started':\n      return 'in-progress';\n    case 'in-progress':\n      return 'complete';\n    default:\n      return 'not-started';\n  }\n}\n\ntype TaskName = 'addInfo' | 'connectBank' | 'review';\n\ntype TaskAction = {\n  type: 'TOGGLE_STATUS';\n  taskName: TaskName;\n};\n\n// Reducer function to handle state updates\nfunction taskReducer(\n  state: Record<TaskName, TaskListItemProps>,\n  action: TaskAction,\n): Record<TaskName, TaskListItemProps> {\n  switch (action.type) {\n    case 'TOGGLE_STATUS':\n      return {\n        ...state,\n        [action.taskName]: {\n          ...state[action.taskName],\n          status: getNextStatus(state[action.taskName].status as string),\n        },\n      };\n    default:\n      return state;\n  }\n}",options:{showRender:!0,showSource:!0,resizable:!1}}},transitional:{9:{source:"import React, {useCallback, useEffect, useState} from 'react';\nimport {\n  FormFieldGroup,\n  TextField,\n  Button,\n  OnboardingView,\n  TaskListItemProps,\n} from '@stripe/ui-extension-sdk/ui';\n\ntype OnboardingData = {\n  state: 'pending' | 'error' | 'ready';\n  tasks: TaskListItemProps[];\n};\n\nconst [onboarding, setOnboarding] = useState<OnboardingData>({\n  state: 'pending',\n  tasks: [],\n});\n\nconst fetchTasks = useCallback(\n  (() => {\n    let isFirstTry = true;\n\n    return () => {\n      setOnboarding({state: 'pending', tasks: []});\n\n      setTimeout(() => {\n        if (isFirstTry) {\n          isFirstTry = false;\n          setOnboarding((prev) => ({...prev, state: 'error'}));\n        } else {\n          setOnboarding({\n            state: 'ready',\n            tasks: [\n              {title: 'Add business info', status: 'in-progress'},\n              {title: 'Connect your bank', status: 'not-started'},\n              {title: 'Review and finish', status: 'not-started'},\n            ],\n          });\n        }\n      }, 2000);\n    };\n  })(),\n  [],\n);\n\nuseEffect(fetchTasks, [fetchTasks]);\n\nconst error =\n  onboarding.state === 'error' ? (\n    <Button onPress={fetchTasks}>Try again!</Button>\n  ) : null;\nconst pending = onboarding.state === 'pending';\n\nreturn (\n  <OnboardingView\n    error={error}\n    pending={pending}\n    title=\"Onboarding title\"\n    description=\"Onboarding description\"\n    completed={false}\n    tasks={onboarding.tasks}\n  >\n    <FormFieldGroup legend=\"Business Info\" description=\"Add business info!\">\n      <TextField\n        label=\"Company name\"\n        placeholder=\"Company name\"\n        hiddenElements={['label']}\n      />\n    </FormFieldGroup>\n  </OnboardingView>\n)",options:{showRender:!0,showSource:!0,resizable:!1}}}},OverviewPage:{basic:{9:{source:"<OverviewPage\n  primaryColumn={\n    <PageModule title={'First column'}>\n      <Box>First Column content</Box>\n    </PageModule>\n  }\n  secondaryColumn={\n    <PageModule title={'Second column'}>\n      <Box>Second Column content</Box>\n    </PageModule>\n  }\n/>",options:{showRender:!0,showSource:!0,resizable:!1}}},pending:{9:{source:"import React from 'react';\nimport {OverviewPage} from '@stripe