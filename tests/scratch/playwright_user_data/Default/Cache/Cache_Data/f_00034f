n      status: 'Active',\n      joinDate: '2023-03-22',\n    },\n    {\n      id: 'user_3',\n      name: 'Mia Patel',\n      email: 'mia@example.com',\n      role: 'viewer',\n      balance: 789 * 100,\n      status: 'Active',\n      joinDate: '2023-05-10',\n    },\n    {\n      id: 'user_4',\n      name: 'Liam Chen',\n      email: 'liam@example.com',\n      role: 'member',\n      balance: 12356 * 100,\n      status: 'Active',\n      joinDate: '2023-02-08',\n    },\n    {\n      id: 'user_5',\n      name: 'Sophia Garcia',\n      email: 'sophia@example.com',\n      role: 'admin',\n      balance: 89 * 100,\n      status: 'Active',\n      joinDate: '2022-11-30',\n    },\n  ],\n};\n\nreturn <ListPage title=\"Basic List Page\" columns={columns} data={data} />\n};\n\nexport default App;",options:{showRender:!1,showSource:!0,resizable:!1}}},controlledPagination:{9:{source:"import {useEffect, useMemo, useState} from 'react';\nimport React from 'react';\nimport {\n  ListPage,\n  ListPageColumn,\n  ListPageData,\n  ListPageItem,\n} from '@stripe/ui-extension-sdk/ui/experimental';\n\nconst App = () => {\n  // Simulates a remote data source (e.g. a database)\nconst users: ListPageItem[] = useMemo(\n  () => [\n    {\n      id: 'user_1',\n      name: 'Ava Lee',\n      department: 'Engineering',\n      location: 'San Francisco',\n    },\n    {\n      id: 'user_2',\n      name: 'Noah Kim',\n      department: 'Engineering',\n      location: 'Seattle',\n    },\n    {\n      id: 'user_3',\n      name: 'Mia Patel',\n      department: 'Marketing',\n      location: 'New York',\n    },\n    {\n      id: 'user_4',\n      name: 'Liam Chen',\n      department: 'Design',\n      location: 'Austin',\n    },\n    {\n      id: 'user_5',\n      name: 'Sophia Garcia',\n      department: 'Operations',\n      location: 'Chicago',\n    },\n    {\n      id: 'user_6',\n      name: 'Ethan Wright',\n      department: 'Engineering',\n      location: 'Denver',\n    },\n    {\n      id: 'user_7',\n      name: 'Olivia Santos',\n      department: 'Finance',\n      location: 'Miami',\n    },\n    {\n      id: 'user_8',\n      name: 'Lucas Nguyen',\n      department: 'Engineering',\n      location: 'Portland',\n    },\n    {\n      id: 'user_9',\n      name: 'Isabella Martinez',\n      department: 'Marketing',\n      location: 'Los Angeles',\n    },\n  ],\n  [],\n);\n\nconst columns: ListPageColumn[] = [\n  {key: 'name', label: 'Name'},\n  {key: 'department', label: 'Department'},\n  {key: 'location', label: 'Location'},\n];\n\nconst pageSize = 3;\n\nconst [currentPage, setCurrentPage] = useState(1);\nconst [data, setData] = useState<ListPageData>({\n  items: [],\n  loading: false,\n});\n\nuseEffect(() => {\n  setData((prev) => ({\n    ...prev,\n    loading: true,\n  }));\n\n  const timerId = setTimeout(() => {\n    const start = (currentPage - 1) * pageSize;\n    const end = start + pageSize;\n    setData({\n      items: users.slice(start, end),\n      loading: false,\n    });\n  }, 150);\n\n  return () => clearTimeout(timerId);\n}, [currentPage, users]);\n\nreturn (\n  <ListPage\n    data={data}\n    columns={columns}\n    pagination={{\n      pageSize,\n      currentPage,\n      totalItems: users.length,\n      onPageChange: setCurrentPage,\n    }}\n  />\n)\n};\n\nexport default App;",options:{showRender:!0,showSource:!0,resizable:!1}}},currencyColumn:{9:{source:"import React from 'react';\nimport {\n  ListPage,\n  ListPageColumn,\n  ListPageData,\n} from '@stripe/ui-extension-sdk/ui/experimental';\n\nconst App = () => {\n  const columns: ListPageColumn[] = [\n  {key: 'name', label: 'Name'},\n  {\n    key: 'balance',\n    label: 'Balance',\n    cell: {\n      type: 'currency',\n      currency: 'USD',\n      currencyKey: 'customCurrency',\n    },\n  },\n];\n\nconst data: ListPageData = {\n  items: [\n    {\n      id: '1',\n      name: 'Ava Lee',\n      balance: 1000,\n    },\n    {\n      id: '2',\n      name: 'Noah Kim',\n      balance: 2000,\n      customCurrency: 'EUR',\n    },\n    {\n      id: '3',\n      name: 'Mia Patel',\n      balance: 3000,\n      customCurrency: 'GBP',\n    },\n  ],\n};\n\nreturn <ListPage columns={columns} data={data} />\n};\n\nexport default App;",options:{showRender:!0,showSource:!0,resizable:!1}}},cursorPagination:{9:{source:"import {useCallback, useEffect, useMemo, useState} from 'react';\nimport React from 'react';\nimport {\n  ListPage,\n  ListPageColumn,\n  ListPageData,\n  ListPageItem,\n} from '@stripe/ui-extension-sdk/ui/experimental';\n\nconst App = () => {\n  // Simulates a remote data source with cursor-based pagination (no total count)\nconst allUsers: ListPageItem[] = useMemo(\n  () => [\n    {\n      id: 'user_1',\n      name: 'Ava Lee',\n      department: 'Engineering',\n      location: 'San Francisco',\n    },\n    {\n      id: 'user_2',\n      name: 'Noah Kim',\n      department: 'Engineering',\n      location: 'Seattle',\n    },\n    {\n      id: 'user_3',\n      name: 'Mia Patel',\n      department: 'Marketing',\n      location: 'New York',\n    },\n    {\n      id: 'user_4',\n      name: 'Liam Chen',\n      department: 'Design',\n      location: 'Austin',\n    },\n    {\n      id: 'user_5',\n      name: 'Sophia Garcia',\n      department: 'Operations',\n      location: 'Chicago',\n    },\n    {\n      id: 'user_6',\n      name: 'Ethan Wright',\n      department: 'Engineering',\n      location: 'Denver',\n    },\n    {\n      id: 'user_7',\n      name: 'Olivia Santos',\n      department: 'Finance',\n      location: 'Miami',\n    },\n    {\n      id: 'user_8',\n      name: 'Lucas Nguyen',\n      department: 'Engineering',\n      location: 'Portland',\n    },\n    {\n      id: 'user_9',\n      name: 'Isabella Martinez',\n      department: 'Marketing',\n      location: 'Los Angeles',\n    },\n  ],\n  [],\n);\n\nconst columns: ListPageColumn[] = [\n  {key: 'name', label: 'Name'},\n  {key: 'department', label: 'Department'},\n  {key: 'location', label: 'Location'},\n];\n\nconst pageSize = 3;\n\nconst [currentPage, setCurrentPage] = useState(1);\nconst [data, setData] = useState<ListPageData>({\n  items: [],\n  loading: false,\n});\nconst [hasMore, setHasMore] = useState(true);\n\nconst fetchPage = useCallback(\n  (page: number) => {\n    console.log('>>> fetch page', {page});\n    setData((prev) => ({\n      ...prev,\n      loading: true,\n    }));\n    setTimeout(() => {\n      const start = (page - 1) * pageSize;\n      const end = start + pageSize;\n      setData({\n        items: allUsers.slice(start, end),\n        loading: false,\n      });\n      setHasMore(end < allUsers.length);\n    }, 500);\n  },\n  [allUsers],\n);\n\nuseEffect(() => {\n  fetchPage(currentPage);\n}, [currentPage, fetchPage]);\n\nconst handlePageChange = useCallback((page: number) => {\n  console.log('>>> handlePageChange', page);\n  setCurrentPage(page);\n}, []);\n\nconsole.log('>>> [example] pagination', {\n  pageSize,\n  currentPage,\n  hasMore,\n  onPageChange: handlePageChange,\n});\n\nreturn (\n  <ListPage\n    data={data}\n    columns={columns}\n    pagination={{\n      pageSize,\n      currentPage,\n      hasMore,\n      onPageChange: handlePageChange,\n    }}\n  />\n)\n};\n\nexport default App;",options:{showRender:!0,showSource:!0,resizable:!1}}},empty:{9:{source:"import React from 'react';\nimport {\n  ListPage,\n  ListPageColumn,\n} from '@stripe/ui-extension-sdk/ui/experimental';\n\nconst columns: ListPageColumn[] = [\n  {key: 'name', label: 'Name'},\n  {key: 'email', label: 'Email', cell: {type: 'link'}},\n  {\n    key: 'status',\n    label: 'Status',\n    cell: {\n      type: 'status',\n      statusMap: {Active: 'positive', Inactive: 'negative'},\n    },\n  },\n];\n\nreturn <ListPage columns={columns} data={{items: []}} />",options:{showRender:!0,showSource:!0,resizable:!1}}},emptyMessage:{9:{source:"import React from 'react';\nimport {\n  ListPage,\n  ListPageColumn,\n} from '@stripe/ui-extension-sdk/ui/experimental';\n\nconst columns: ListPageColumn[] = [\n  {key: 'name', label: 'Name'},\n  {key: 'email', label: 'Email', cell: {type: 'link'}},\n  {\n    key: 'status',\n    label: 'Status',\n    cell: {\n      type: 'status',\n      statusMap: {Active: 'positive', Inactive: 'negative'},\n    },\n  },\n];\n\nreturn (\n  <ListPage\n    columns={columns}\n    data={{items: []}}\n    emptyMessage=\"No matching team members found.\"\n  />\n)",options:{showRender:!0,showSource:!0,resizable:!1}}},emptyMessageAction:{9:{source:"import React from 'react';\nimport {\n  ListPage,\n  ListPageColumn,\n} from '@stripe/ui-extension-sdk/ui/experimental';\n\nconst columns: ListPageColumn[] = [\n  {key: 'name', label: 'Name'},\n  {key: 'email', label: 'Email', cell: {type: 'link'}},\n  {\n    key: 'status',\n    label: 'Status',\n    cell: {\n      type: 'status',\n      statusMap: {Active: 'positive', Inactive: 'negative'},\n    },\n  },\n];\n\nreturn (\n  <ListPage\n    columns={columns}\n    data={{items: []}}\n    emptyMessage={{\n      message: 'No matching team members found.',\n      action: {\n        label: 'Invite teammate',\n        href: 'https://example.com/invite',\n      },\n    }}\n  />\n)",options:{showRender:!0,showSource:!0,resizable:!1}}},headerActions:{9:{source:"import React from 'react';\nimport {\n  ListPage,\n  ListPageColumn,\n  ListPageItem,\n} from '@stripe/ui-extension-sdk/ui/experimental';\n\nconst App = () => {\n  const [items, setItems] = useState<ListPageItem[]>([]);\nconst [loading, setLoading] = useState(false);\n\nconst columns: ListPageColumn[] = [\n  {key: 'name', label: 'Name'},\n  {key: 'email', label: 'Email', cell: {type: 'link'}},\n];\n\nconst addUser = () => {\n  setLoading(true);\n\n  setTimeout(() => {\n    setItems((prevItems) => [\n      ...prevItems,\n      {\n        id: (prevItems.length + 1).toString(),\n        name: 'User',\n        email: 'user@example.com',\n      },\n    ]);\n    setLoading(false);\n  }, 100);\n};\n\nconst exportUsers = () => {\n  console.log('Export action');\n}