atus',\n      statusMap: {Active: 'positive', Inactive: 'negative'},\n    },\n  },\n  {key: 'joinDate', label: 'Join Date', cell: {type: 'date'}},\n];\n\nconst users: DataTableItem[] = [\n  {\n    id: 'user_1',\n    name: 'Ava Lee',\n    email: 'ava@example.com',\n    role: 'admin',\n    balance: 123 * 100,\n    status: 'Active',\n    joinDate: '2023-01-15',\n  },\n  {\n    id: 'user_2',\n    name: 'Noah Kim',\n    email: 'noah@example.com',\n    role: 'member',\n    balance: 456 * 100,\n    status: 'Active',\n    joinDate: '2023-03-22',\n  },\n  {\n    id: 'user_3',\n    name: 'Mia Patel',\n    email: 'mia@example.com',\n    role: 'viewer',\n    balance: 789 * 100,\n    status: 'Active',\n    joinDate: '2023-05-10',\n  },\n  {\n    id: 'user_4',\n    name: 'Liam Chen',\n    email: 'liam@example.com',\n    role: 'member',\n    balance: 12356 * 100,\n    status: 'Active',\n    joinDate: '2023-02-08',\n  },\n  {\n    id: 'user_5',\n    name: 'Sophia Garcia',\n    email: 'sophia@example.com',\n    role: 'admin',\n    balance: 89 * 100,\n    status: 'Active',\n    joinDate: '2022-11-30',\n  },\n];\n\nreturn <DataTable items={users} columns={columns} />\n};\n\nexport default App;",options:{showRender:!0,showSource:!0,resizable:!1}}},batchSelection:{9:{source:"import React from 'react';\nimport {\n  DataTable,\n  DataTableColumn,\n  DataTableItem,\n} from '@stripe/ui-extension-sdk/ui';\n\nconst App = () => {\n  const users: DataTableItem[] = [\n  {\n    id: 'user_1',\n    name: 'Ava Lee',\n    email: 'ava@example.com',\n    department: 'Engineering',\n  },\n  {\n    id: 'user_2',\n    name: 'Noah Kim',\n    email: 'noah@example.com',\n    department: 'Engineering',\n  },\n  {\n    id: 'user_3',\n    name: 'Mia Patel',\n    email: 'mia@example.com',\n    department: 'Marketing',\n  },\n  {\n    id: 'user_4',\n    name: 'Liam Chen',\n    email: 'liam@example.com',\n    department: 'Design',\n  },\n  {\n    id: 'user_5',\n    name: 'Sophia Garcia',\n    email: 'sophia@exampl