n-sdk/ui';\n\nconst columns: DetailPageModuleTableColumn[] = [\n  {key: 'id', label: 'ID'},\n  {key: 'name', label: 'Name'},\n  {\n    key: 'status',\n    label: 'Status',\n    cell: {\n      type: 'status',\n      statusMap: {\n        Active: 'positive',\n        Inactive: 'negative',\n      },\n    },\n  },\n];\n\nconst [items, setItems] = React.useState<DetailPageModuleTableItem[]>([\n  {id: '1', name: 'Item 1', status: 'Active'},\n  {id: '2', name: 'Item 2', status: 'Active'},\n  {id: '3', name: 'Item 3', status: 'Active'},\n  {id: '4', name: 'Item 4', status: 'Active'},\n  {id: '5', name: 'Item 5', status: 'Active'},\n]);\n\nconst updateItemStatus = React.useCallback(\n  (item: DetailPageModuleTableItem, newStatus: string) => {\n    setItems((prevItems) =>\n      prevItems.map((prevItem) =>\n        prevItem.id === item.id ? {...prevItem, status: newStatus} : prevItem,\n      ),\n    );\n  },\n  [],\n);\n\nconst rowActions: DetailPageModuleTableRowAction[] = [\n  {\n    id: 'delete',\n    label: 'Delete',\n    type: 'destructive',\n    onPress: (item) => {\n      setItems((prevItems) =>\n        prevItems.filter((prevItem) => prevItem.id !== item.id),\n      );\n    },\n  },\n];\n\nconst rowActionGroups: DetailPageModuleTableRowActionGroup[] = [\n  {\n    id: 'edit',\n    label: 'Edit',\n    actions: [\n      {\n        id: 'deactivate',\n        label: 'Deactivate',\n        onPress: (item) => updateItemStatus(item, 'Inactive'),\n      },\n      {\n        id: 'activate',\n        label: 'Activate',\n        onPress: (item) => updateItemStatus(item, 'Active'),\n      },\n    ],\n  },\n  {\n    id: 'links',\n    label: 'Links',\n    actions: [\n      {\n        id: 'link-with-route-desc',\n        label: 'Dashboard customer',\n        href: {\n          name: 'customerDetails',\n          params: {\n            customerId: 'cus_12345689',\n          },\n        },\n      },\n      {\n        id: 'stripe-apps-docs',\n        label: 'Stripe Apps docs',\n        