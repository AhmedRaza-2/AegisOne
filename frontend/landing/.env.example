# ─── Supabase (Required for Organization Registration/Login) ───────────────────
# Put these values in the repository-root .env; Vite reads that file.
# Get these from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# These are public browser settings. Admin passwords, SETUP_KEY, database/JWT
# secrets and Supabase service-role/secret keys must never use the VITE_ prefix.

# ─── AI Features (Optional) ───────────────────────────────────────────────────
# Local npm run dev reads GROQ_API_KEY from the repository-root .env or shell.
# Keep that key server-only (no VITE_ prefix); no hosted API URL is needed locally.
# Restart npm run dev after adding/changing the server key.
# Production provider keys belong only in hosted function secrets, never VITE_*.
VITE_ASSISTANT_ENABLED=false
VITE_ASSISTANT_VOICE_ENABLED=false
VITE_ASSISTANT_API_URL=
