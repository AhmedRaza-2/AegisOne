# No .dockerignore existed before — every `docker compose build` was sending the
# entire repo root (including .git history and DB backups) to the Docker daemon as
# build context, regardless of which service's Dockerfile was building. Measured at
# 1GB+ for a single backend build. None of this is needed by any Dockerfile here.

.git
.github

# Backend only needs api/, AIML/, Extension/, requirements.txt (see Dockerfile.backend) —
# everything below is for other services or isn't needed by any image build.
frontend/*/node_modules
frontend/*/.next
frontend/*/dist
frontend/*/build
aegisone-backups

__pycache__
*.pyc
.pytest_cache
.venv
venv

.claude
.vscode
.idea
*.log
.cache
.tmp
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
frontend/shared-assistant/vendor
frontend/shared-assistant/*.tgz

# Evaluation corpora and caches (600MB+) and rejected experiments are not needed at runtime
AIML/eval
AIML/url/kaggle
AIML/url/heads_refresh_candidate.pt
AIML/message/kaggle

# Superseded URL generations (the server loads the newest installed one) and the M1 training bundle
AIML/url/v8
AIML/url/v9
AIML/message/kaggle
