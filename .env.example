# AegisOne — Environment Variables
# Copy this file to .env and fill in your values.
# The API reads these at startup via os.environ.get().

# ── Database ─────────────────────────────────────────────────────────────────
# Development (default — SQLite, no setup needed):
# AEGIS_DATABASE_URL=sqlite+aiosqlite:///./api/database/aegisone.db

# Production (PostgreSQL via pgAdmin or Docker):
# AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:YOUR_PASSWORD@localhost:5432/aegisone

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AEGIS_JWT_SECRET=change-me-in-production

# ── Server ───────────────────────────────────────────────────────────────────
# AEGIS_PORT=9000
# AEGIS_WORKERS=4

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Required for sending welcome emails and alerts.
# For Gmail, you MUST use an "App Password" if 2-Step Verification is enabled.
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ── Landing (Supabase Platform Admin) ──────────────────────────────────────────
# Public connection only. Supabase RLS/RPC policies authorize access.
# Never put an admin password, setup key or service-role key in VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only provisioning secret. Leave empty to generate/persist it at startup.
SETUP_KEY=

# Landing-homepage assistant. Public build configuration only; secrets stay server-side.
# Landing Vite reads this root .env (see vite.config.ts).
VITE_ASSISTANT_ENABLED=false
VITE_ASSISTANT_VOICE_ENABLED=false
VITE_ASSISTANT_API_URL=https://your-project.supabase.co/functions/v1/assistant

